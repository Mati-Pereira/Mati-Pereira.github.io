---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { t, link, other, type Lang } from '../i18n/ui';
import { getPosts } from '../lib/posts';

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const posts = await getPosts(lang);
---
<BaseLayout lang={lang} altHref={link(other(lang))}>
  <h1>{ui.siteTitle}</h1>
  <p>{ui.siteDescription}</p>
  <h2>{ui.latest}</h2>
  {posts.length ? posts.map((post) => <PostCard post={post} lang={lang} />) : <p>{ui.noPosts}</p>}
</BaseLayout>
