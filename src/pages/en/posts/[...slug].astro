---
import PostView from '/src/views/PostView.astro';
import { getPosts, slugOf } from '/src/lib/posts';

export async function getStaticPaths() {
  return (await getPosts('en')).map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props;
---
<PostView lang="en" post={post} />
