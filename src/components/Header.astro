---
import { t, link, other, type Lang } from '../i18n/ui';

interface Props { lang: Lang; altHref?: string }
const { lang, altHref } = Astro.props;
const ui = t(lang);
const path = Astro.url.pathname;
const items = [
  [ui.nav.home, link(lang)],
  [ui.nav.tags, link(lang, 'tags')],
  [ui.nav.timeline, link(lang, 'timeline')],
  [ui.nav.about, link(lang, ui.aboutPath)],
  [ui.nav.search, link(lang, 'search')],
] as const;
const alt = altHref ?? link(other(lang));
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={link(lang)}>{ui.siteTitle}</a>
    <nav>
      {items.map(([label, href]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="tools">
      <a class="lang" href={alt} hreflang={other(lang)}>{other(lang).toUpperCase()}</a>
      <button type="button" id="theme-toggle" aria-label={ui.toggleTheme} title={ui.toggleTheme}>◐</button>
    </div>
  </div>
</header>
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
